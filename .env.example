# --------------------------------------------------------------------
# Gigmote — environment variables
#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit secrets.
# --------------------------------------------------------------------

# Public site URL — used for sitemap, OG, and canonical metadata.
NEXT_PUBLIC_SITE_URL=https://gigmote.com

# --------------------------------------------------------------------
# EmailJS — powers the /contact and /join-gigmote forms.
# Sign up at https://www.emailjs.com, create a service, and create
# two templates: one for general inquiries, one for applications.
#
# These vars are PUBLIC because EmailJS runs client-side. The "public
# key" is rate-limited and CORS-restricted on EmailJS's end.
# --------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_APPLICATION_TEMPLATE_ID=template_yyyyyyy
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=publickey_xxxxxxxxxxxxx

# --------------------------------------------------------------------
# Prisma + NextAuth (used by admin panel — ported but currently unused)
# --------------------------------------------------------------------
# DATABASE_URL=postgres://user:pass@host:5432/gigmote
# AUTH_SECRET=...
# AUTH_TRUST_HOST=true

# --------------------------------------------------------------------
# Vercel Blob (used for uploads in the application form)
# --------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
