    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.4",
    "@studio-freight/lenis": "^1.0.42",
    "@vercel/blob": "^2.3.3",
    "framer-motion": "^12.34.0",
    "gsap": "^3.12.5",
    "lucide-react": "^0.563.0",
    "motion": "^12.40.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.31",
