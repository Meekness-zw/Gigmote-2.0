# Local-dev defaults. Committed and safe to share.
# Real secrets (SMTP creds, Blob tokens) live in .env.local (gitignored)
# and override anything set here.

# Local SQLite database — lives in prisma/dev.db. Migration creates it.
DATABASE_URL="file:./dev.db"

# Auth.js — dev secret. Rotated value lives in .env.local for production.
AUTH_SECRET="dev-secret-change-me-in-production-9f3a8b2c1d4e5f6a7b8c9d0e1f2a3b4c"
AUTH_TRUST_HOST="true"

# Default admin allowlist for local dev (no SMTP needed → credentials provider).
# Add real admin emails in .env.local.
ADMIN_EMAILS="admin@gigmote.test"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
